# Backend environment (no real credentials)
PORT=5000
NODE_ENV=development
# Restrict CORS to the frontend origin
CLIENT_URL=http://localhost:5173
# PostgreSQL connection string (prepared for Prisma; required for DB integration)
# Example format: postgresql://admin:password@localhost:5432/portfolio_db?schema=public
DATABASE_URL=""
# Supabase project URL from Project Settings > API (not the PostgreSQL connection string)
SUPABASE_URL=https://your-project-ref.supabase.co
# Set the service-role key only in the server's private environment
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=portfolio-assets
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:5173
# Set these only when running the one-time administrator setup script.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
