# Backend environment (no real credentials)
PORT=5000
NODE_ENV=development
# Restrict CORS to the frontend origin
CLIENT_URL=http://localhost:5173
# PostgreSQL connection string (prepared for Prisma; required for DB integration)
# Example format: postgresql://admin:password@localhost:5432/portfolio_db?schema=public
DATABASE_URL=""
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:5173
# Set these only when running the one-time administrator setup script.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
