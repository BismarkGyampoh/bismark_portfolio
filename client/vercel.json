{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://bismark-portfolio.onrender.com/api/v1/:path*"
    },
    {
      "source": "/uploads/media/:path*",
      "destination": "https://bismark-portfolio.onrender.com/uploads/media/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
